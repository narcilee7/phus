{
  "name": "phus",
  "version": "0.1.0",
  "description": "",
  "main": "dist/phus.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:js": "tsdown",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsx src/phus.ts",
    "chat": "tsx src/phus.ts chat",
    "run": "tsx src/phus.ts run",
    "gateway": "tsx src/phus.ts gateway",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --quiet src test",
    "lint:fix": "oxlint --fix src test",
    "lint:report": "oxlint --format=stylish src test",
    "lint:all": "oxlint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "logs:pretty": "pino-pretty -f -t $(node -e \"console.log(process.env.PHUS_LOG_FILE || './logs/phus.jsonl')\")"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "phus": "dist/phus.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "jiti": "^2.6.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@biomejs/biome",
      "koffi",
      "protobufjs",
      "@google/genai"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.74.0",
    "rolldown": "^1.2.0",
    "tsdown": "^0.19.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}