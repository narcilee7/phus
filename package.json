{
  "name": "phus",
  "version": "0.1.0",
  "description": "Self-evolving agent runtime. Push the stone up the mountain.",
  "main": "dist/phus.mjs",
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist",
    "scripts/install.sh",
    "scripts/install.ps1",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "phus.config.example.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:js": "tsdown",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsx src/phus.ts",
    "chat": "tsx src/phus.ts chat",
    "run": "tsx src/phus.ts run",
    "gateway": "tsx src/phus.ts gateway",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --quiet src test",
    "lint:fix": "oxlint --fix src test",
    "lint:report": "oxlint --format=stylish src test",
    "lint:all": "oxlint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "logs:pretty": "pino-pretty -f -t $(node -e \"console.log(process.env.PHUS_LOG_FILE || './logs/phus.jsonl')\")",
    "gui:dev": "pnpm -C apps/gui dev",
    "gui:build": "pnpm -C apps/gui build",
    "gui:dist": "pnpm -C apps/gui dist",
    "gui:dist:mac": "pnpm -C apps/gui dist:mac",
    "gui:dist:win": "pnpm -C apps/gui dist:win",
    "gui:dist:linux": "pnpm -C apps/gui dist:linux",
    "gui:typecheck": "pnpm -C apps/gui typecheck",
    "gui:test": "pnpm -C apps/gui test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "phus": "dist/phus.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "^0.34.52",
    "@slack/bolt": "^4.2.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "imap": "^0.8.19",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "jiti": "^2.6.1",
    "mailparser": "^3.7.2",
    "marked": "^18.0.6",
    "nodemailer": "^6.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "telegraf": "^4.16.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@biomejs/biome",
      "koffi",
      "protobufjs",
      "@google/genai",
      "electron",
      "@electron/rebuild"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^6.4.17",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.74.0",
    "rolldown": "^1.2.0",
    "tsdown": "^0.19.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}