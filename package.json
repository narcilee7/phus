{
	"name": "phus",
	"version": "0.1.0",
	"description": "Self-evolving agent runtime. Push the stone up the mountain.",
	"private": true,
	"license": "ISC",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"build:js": "pnpm -r build:js",
		"build:types": "pnpm -r build:types",
		"dev": "PHUS_HOME=$PWD/.phus TSX_TSCONFIG_PATH=packages/runtime/tsconfig.json tsx packages/runtime/src/phus.ts",
		"chat": "PHUS_HOME=$PWD/.phus TSX_TSCONFIG_PATH=packages/runtime/tsconfig.json tsx packages/runtime/src/phus.ts chat",
		"run": "PHUS_HOME=$PWD/.phus TSX_TSCONFIG_PATH=packages/runtime/tsconfig.json tsx packages/runtime/src/phus.ts run",
		"gateway": "PHUS_HOME=$PWD/.phus TSX_TSCONFIG_PATH=packages/runtime/tsconfig.json tsx packages/runtime/src/phus.ts gateway",
		"tui": "PHUS_HOME=$PWD/.phus TSX_TSCONFIG_PATH=packages/tui/tsconfig.json tsx packages/tui/src/index.ts",
		"typecheck": "pnpm -r typecheck",
		"lint": "oxlint --quiet packages apps test",
		"lint:fix": "oxlint --fix packages apps test",
		"test": "pnpm -r test",
		"test:watch": "pnpm -r --parallel test:watch",
		"test:cov": "pnpm -r test:cov",
		"logs:pretty": "pino-pretty -f -t $(node -e \"console.log(process.env.PHUS_LOG_FILE || './logs/phus.jsonl')\")",
		"gui:dev": "pnpm -C apps/gui dev",
		"gui:build": "pnpm -C apps/gui build",
		"gui:dist": "pnpm -C apps/gui dist",
		"gui:dist:mac": "pnpm -C apps/gui dist:mac",
		"gui:dist:win": "pnpm -C apps/gui dist:win",
		"gui:dist:linux": "pnpm -C apps/gui dist:linux",
		"gui:typecheck": "pnpm -C apps/gui typecheck",
		"gui:test": "pnpm -C apps/gui test",
		"smoke:tui": "pnpm --filter @phus/tui smoke"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"@biomejs/biome",
			"koffi",
			"protobufjs",
			"@google/genai",
			"electron",
			"@electron/rebuild"
		]
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/diff": "^8.0.0",
		"@types/imap": "^0.8.42",
		"@types/mailparser": "^3.4.5",
		"@types/node": "^26.1.1",
		"@types/react": "^19.0.1",
		"oxlint": "^1.0.0",
		"pino-pretty": "^13.1.3",
		"tsdown": "^0.19.0",
		"tsx": "^4.20.6",
		"typescript": "^7.0.0",
		"vitest": "^4.1.0"
	}
}