{
  "name": "phus",
  "version": "0.1.4",
  "description": "Self-evolving agent runtime. Push the stone up the mountain.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:js": "pnpm -r build:js",
    "build:types": "pnpm -r build:types",
    "dev": "PHUS_HOME=$PWD/.phus tsx apps/cli/src/main.ts",
    "chat": "PHUS_HOME=$PWD/.phus tsx apps/cli/src/main.ts chat",
    "run": "PHUS_HOME=$PWD/.phus tsx apps/cli/src/main.ts run",
    "gateway": "PHUS_HOME=$PWD/.phus tsx apps/cli/src/main.ts gateway",
    "tui": "PHUS_HOME=$PWD/.phus tsx packages/tui/src/index.ts",
    "web:dev": "pnpm --filter @phus/web dev",
    "web:build": "pnpm --filter @phus/web build",
    "desktop:dev": "pnpm --filter @phus/desktop dev",
    "desktop:build": "pnpm --filter @phus/desktop build",
    "desktop:dist": "pnpm --filter @phus/desktop dist",
    "typecheck": "tsc -b",
    "lint": "oxlint --quiet packages apps test",
    "lint:fix": "oxlint --fix packages apps test",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:cov": "pnpm -r test:cov",
    "logs:pretty": "pino-pretty -f -t $(node -e \"console.log(process.env.PHUS_LOG_FILE || './logs/phus.jsonl')\")",
    "smoke:tui": "pnpm --filter @phus/tui smoke"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@biomejs/biome",
      "koffi",
      "protobufjs",
      "@google/genai",
      "electron",
      "@electron/rebuild"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.1",
    "oxlint": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.19.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
