{
  "name": "@phus/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Phus agent runtime: bridge, core, channels. Headless library — no bin, no TUI.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./bridge/*": "./dist/bridge/*",
    "./channels/*": "./dist/channels/*",
    "./commands/*": "./dist/commands/*",
    "./core/*": "./dist/core/*",
    "./infra/*": "./dist/infra/*",
    "./types/*": "./dist/types/*",
    "./utils/*": "./dist/utils/*",
    "./runtime/*": "./dist/runtime/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/fix-extensions.mjs dist",
    "build:js": "tsc && node ../../scripts/fix-extensions.mjs dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "lint": "oxlint --quiet src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "^0.34.52",
    "@slack/bolt": "^4.2.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "imap": "^0.8.19",
    "jiti": "^2.6.1",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prismjs": "^1.30.0",
    "telegraf": "^4.16.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "@phus/core": "workspace:*",
    "@phus/shared": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1"
  }
}
