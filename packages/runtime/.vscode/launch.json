{
  // packages/runtime/.vscode/launch.json
  //
  // Debug configs for the runtime library. Most consumers hit
  // runtime through the CLI bin, but these configs let you run
  // vitest specs under the debugger or attach to a specific
  // runtime-side module.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Current test file (vitest)",
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}", "--reporter=verbose"],
      "cwd": "${workspaceRoot}/packages/runtime",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "All runtime tests",
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceRoot}/packages/runtime",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}