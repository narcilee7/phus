{
  "name": "@phus/phus-design",
  "version": "0.1.0",
  "private": true,
  "description": "Phus design system — shadcn/ui-style component library on Radix + Tailwind. Reusable across apps/web, apps/mobile, apps/desktop. TUI lives in @phus/tui (pi-tui, no React).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./hooks/*": "./dist/hooks/*",
    "./lib/*": "./dist/lib/*",
    "./styles/*": "./dist/styles/*",
    "./tailwind.config.mjs": "./tailwind.config.mjs",
    "./postcss.config.mjs": "./postcss.config.mjs"
  },
  "files": [
    "dist",
    "tailwind.config.mjs",
    "postcss.config.mjs",
    "components.json",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:js": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:types": "rm -rf .tsbuildinfo dist && tsc --emitDeclarationOnly --declaration --declarationMap false --sourceMap false",
    "build:full": "rm -rf .tsbuildinfo dist && tsc",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
