{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "tsBuildInfoFile": "./.tsbuildinfo",
    // shadcn-style component imports use the `@/` alias. Maps to
    // src/ — same convention shadcn/ui uses in components.json.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", ".tsbuildinfo"],
  "references": [
    { "path": "../shared" }
  ]
}