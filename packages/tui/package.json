{
  "name": "@phus/tui",
  "version": "0.1.1",
  "description": "Phus terminal UI: pi-tui based chat interface (vendored @mariozechner/pi-tui primitives, no React, no ink).",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false && node ../../scripts/fix-extensions.mjs dist",
    "build:js": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false && node ../../scripts/fix-extensions.mjs dist",
    "build:types": "rm -rf .tsbuildinfo && tsc --emitDeclarationOnly --declaration --declarationMap false --sourceMap false",
    "build:full": "rm -rf .tsbuildinfo dist && tsc && node ../../scripts/fix-extensions.mjs dist",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx ../../scripts/smoke-pi-tui.ts"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@phus/core": "workspace:*",
    "@phus/runtime": "workspace:*",
    "@phus/shared": "workspace:*",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "get-east-asian-width": "1.6.0",
    "marked": "^18.0.6",
    "prismjs": "^1.30.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6"
  }
}
