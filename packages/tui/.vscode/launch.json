{
  // packages/tui/.vscode/launch.json
  //
  // Debug configs for the TUI library. The TUI uses pi-tui which
  // requires a real terminal; the launch below allocates a pty so
  // breakpoints work inside the rendered UI.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Current tui test file (vitest)",
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}", "--reporter=verbose"],
      "cwd": "${workspaceRoot}/packages/tui",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "All tui tests",
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceRoot}/packages/tui",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}