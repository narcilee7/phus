{
  "name": "@phus/core",
  "version": "0.1.1",
  "description": "Phus core: headless public surface — types, constants, hook/tape/skill interfaces. Re-exports from @phus/runtime today; physical files will move here in follow-up commits. See documents/Proposal-Monorepo-Split.md §3.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types/*": "./dist/types/*",
    "./types/*.js": "./dist/types/*.js",
    "./types/**/*.js": "./dist/types/**/*.js",
    "./utils/*": "./dist/utils/*",
    "./utils/*.js": "./dist/utils/*.js",
    "./runtime/*": "./dist/runtime/*",
    "./runtime/*.js": "./dist/runtime/*.js",
    "./runtime/**/*.js": "./dist/runtime/**/*.js",
    "./session/*": "./dist/session/*",
    "./session/*.js": "./dist/session/*.js",
    "./session/**/*.js": "./dist/session/**/*.js",
    "./infra/*": "./dist/infra/*",
    "./infra/*.js": "./dist/infra/*.js",
    "./infra/**/*.js": "./dist/infra/**/*.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false && node ../../scripts/fix-extensions.mjs dist",
    "build:js": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false && node ../../scripts/fix-extensions.mjs dist",
    "build:types": "rm -rf .tsbuildinfo dist && tsc --emitDeclarationOnly --declaration --declarationMap false --sourceMap false",
    "build:full": "rm -rf .tsbuildinfo dist && tsc && node ../../scripts/fix-extensions.mjs dist",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {},
  "dependencies": {
    "@phus/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2"
  }
}
