{
  "name": "@phus/core",
  "version": "0.1.0",
  "private": true,
  "description": "Phus core: headless public surface — types, constants, hook/tape/skill interfaces. Re-exports from @phus/runtime today; physical files will move here in follow-up commits. See documents/Proposal-Monorepo-Split.md §3.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types/*": "./dist/types/*",
    "./utils/*": "./dist/utils/*",
    "./runtime/*": "./dist/runtime/*",
    "./session/*": "./dist/session/*",
    "./infra/*": "./dist/infra/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/fix-extensions.mjs dist",
    "build:js": "tsc && node ../../scripts/fix-extensions.mjs dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "lint": "oxlint --quiet src test",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {},
  "dependencies": {
    "@phus/shared": "workspace:*",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2"
  }
}
