{
  "name": "@phus/web",
  "version": "0.1.0",
  "private": true,
  "description": "Phus web host — browser-based React 19 SPA. Future home for the full Web UI; uses @phus/phus-design for components and @phus/runtime for the headless agent.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:js": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:types": "rm -rf .tsbuildinfo dist && tsc --emitDeclarationOnly --declaration --declarationMap false --sourceMap false",
    "build:full": "rm -rf .tsbuildinfo dist && tsc",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/index.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@phus/core": "workspace:*",
    "@phus/phus-design": "workspace:*",
    "@phus/runtime": "workspace:*",
    "@phus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}