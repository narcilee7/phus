# apps/gui/.gitignore
# Build artifacts and runtime state for the Electron GUI.

# Vite / electron-vite output
out/
dist-app/

# electron-builder caches
.cache/

# Logs
logs/
*.log
npm-debug.log*

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local env / secrets
.env
.env.local

# Runtime state (matches the root-level .gitignore for tape/sqlite/etc.)
*.sqlite*
tape.sqlite*