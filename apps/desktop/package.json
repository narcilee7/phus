{
  "name": "@phus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Phus desktop host — Electron app with embedded Phus runtime. Loads the Next.js renderer from @phus/web and bridges it to the local agent via IPC.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron --enable-logging dist/main/index.js",
    "build": "rm -rf dist .tsbuildinfo* && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "rebuild": "electron-rebuild",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@phus/core": "workspace:*",
    "@phus/runtime": "workspace:*",
    "@phus/shared": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@types/node": "^26.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
