{
  "name": "@phus/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Phus mobile host — React Native / Expo target. Placeholder for the iOS / Android app; shares @phus/phus-design + @phus/runtime with web.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:js": "rm -rf .tsbuildinfo dist && tsc --sourceMap false --declarationMap false",
    "build:types": "rm -rf .tsbuildinfo dist && tsc --emitDeclarationOnly --declaration --declarationMap false --sourceMap false",
    "build:full": "rm -rf .tsbuildinfo dist && tsc",
    "typecheck": "tsc -b ../../tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/index.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.79.0"
  },
  "dependencies": {
    "@phus/core": "workspace:*",
    "@phus/phus-design": "workspace:*",
    "@phus/runtime": "workspace:*",
    "@phus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.1",
    "react": "^19.0.0"
  }
}