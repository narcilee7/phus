# ═══════════════════════════════════════════════════════════════
# Phus configuration — copy to `.env` and fill in your secrets.
# Every variable has a default baked into the code; only set what
# you need to override.
# ═══════════════════════════════════════════════════════════════


# ─── Model ────────────────────────────────────────────────────
# Format: <provider>/<modelId>
# Pi's getModel() resolves this — see node_modules/@mariozechner/pi-ai/dist/models.generated.d.ts
# for the full registry of supported (provider, modelId) pairs.
#
# Common choices:
#   anthropic/claude-sonnet-4-20250514     (Anthropic direct)
#   openai/gpt-4o                            (OpenAI direct)
#   google/gemini-2.5-flash                  (Google AI Studio)
#   openrouter/anthropic/claude-3.5-sonnet   (OpenRouter proxy)
#   deepseek/deepseek-v3                     (DeepSeek direct)
#   deepseek/deepseek-v3-250324              (Volcano Ark DeepSeek-V3)
#
PHUS_MODEL=anthropic/claude-sonnet-4-20250514

# Override the provider's base URL — needed for OpenAI-compatible gateways
# that piggyback on a built-in provider (Volcano Ark, Azure, self-hosted vLLM).
# When unset, the provider's default URL is used (e.g. https://api.deepseek.com
# for the deepseek provider, https://api.openai.com for openai).
#
# Examples:
#   https://ark.cn-beijing.volces.com/api/v3     (Volcano Ark)
#   https://your-vllm.internal/v1                (self-hosted vLLM)
#   https://api.deepseek.com                     (DeepSeek direct)
#
# PHUS_BASE_URL=

# Override the model id sent to the API — needed when the gateway uses its own
# model naming (Volcano Ark gives each deployment an "ep-xxxxxxxx" id, while
# the upstream model is "deepseek-v3"). PHUS_MODEL still uses Pi's registry
# name for type-safety; PHUS_MODEL_ID is what actually hits the wire.
# When unset, the id from Pi's registry (the part after "/" in PHUS_MODEL) is used.
#
# Example (Volcano Ark):
#   PHUS_MODEL=deepseek/deepseek-v4-pro        # for Pi's type registry
#   PHUS_MODEL_ID=ep-20241120-abc123           # actual Volcano Ark endpoint id
#
# PHUS_MODEL_ID=


# ─── Filesystem layout ────────────────────────────────────────
# Phus's home — holds skills, tape, plugins, startup.sh.
PHUS_HOME=./.phus

# SQLite tape (one row per turn / tool_call / tool_result / anchor / error).
PHUS_TAPE_DB=./.phus/tape.sqlite

# Skills directory — Agent Skills standard layout (one dir per skill, SKILL.md inside).
PHUS_SKILLS_DIR=./skills

# Structured JSON log file (pino). Each line is one event.
PHUS_LOG_FILE=./logs/phus.jsonl

# Minimum log level: fatal | error | warn | info | debug | trace
PHUS_LOG_LEVEL=info


# ─── Provider API keys ────────────────────────────────────────
# Pi's getEnvApiKey() reads these automatically based on the provider
# in PHUS_MODEL. Set ONE (or more) and you're ready.
#
# Direct providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=                # also used when PHUS_BASE_URL points to Volcano Ark
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
HF_TOKEN=                        # HuggingFace

# Aggregators / proxies:
OPENROUTER_API_KEY=              # https://openrouter.ai
ANTHROPIC_OAUTH_TOKEN=           # Claude Pro/Max OAuth (overrides ANTHROPIC_API_KEY)


# ─── Channels ─────────────────────────────────────────────────
# Telegram bot token (used by `phus gateway --telegram`).
TELEGRAM_TOKEN=

# Telegram allowlists (comma-separated; empty = allow all).
# Set these to lock the bot to specific users / chats.
TELEGRAM_ALLOW_USERS=
TELEGRAM_ALLOW_CHATS=


# ─── Misc ─────────────────────────────────────────────────────
# Set to non-empty to skip the startup.sh bootstrap on gateway boot.
# PHUS_SKIP_STARTUP=
