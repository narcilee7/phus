# Phus environment variables
# Copy this to .phus/.env and fill in your keys:
#   cp .env.example .phus/.env

# ─── Provider (pick at least one) ───
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI
# OPENAI_API_KEY=sk-...
# DeepSeek
# DEEPSEEK_API_KEY=sk-...
# Gemini
# GEMINI_API_KEY=...
# OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# ─── Volcano Ark (DeepSeek via 火山方舟) ───
# VOLCANO_API_KEY=ark-...
# VOLCANO_WIRE_ID=ep-m-...

# ─── Optional ───
# PHUS_LOG_LEVEL=info
# PHUS_DEBUG_WIRE=1