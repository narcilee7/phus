# Phus configuration — copy to .env and fill in

# Model: <provider>/<modelId>
# See node_modules/@mariozechner/pi-ai/dist/models.generated.d.ts for available models.
PHUS_MODEL=anthropic/claude-sonnet-4-20250514

# Phus home directory (skills, tape, startup.sh)
PHUS_HOME=./.phus

# Tape SQLite path
PHUS_TAPE_DB=./tape.sqlite

# Skills directory
PHUS_SKILLS_DIR=./skills

# Provider API keys (Pi reads these automatically)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Telegram channel (gateway --telegram)
TELEGRAM_TOKEN=
